# Email signup storage (spec §12) — signups are stored in our own Postgres.
# On Vercel: attach Vercel Postgres to the project and POSTGRES_URL is set
# automatically. Any other Postgres works too via DATABASE_URL.
# Until one is set, signups validate but are not stored (server logs a warning).
# Table (auto-created on first signup): hairiq_subscribers
#   email (unique) · tiers text[] · zip · created_at
POSTGRES_URL=
# DATABASE_URL=
