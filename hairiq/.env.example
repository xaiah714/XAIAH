# --- Email signup storage (spec §12) -----------------------------------------
# Signups are stored in our own Postgres. On Vercel: attach Vercel Postgres to
# the project and POSTGRES_URL is set automatically. Any other Postgres works
# too via DATABASE_URL. Until one is set, signups validate but are not stored
# (server logs a warning).
# Table (auto-created on first signup): hairiq_subscribers
#   email (unique) · tiers text[] · zip · created_at
POSTGRES_URL=
# DATABASE_URL=

# --- Email delivery (rev 7) — confirmation emails + newsletters via Resend ---
# 1. resend.com → API Keys → paste here. Signups then get a welcome email.
RESEND_API_KEY=
# 2. After verifying your domain in Resend (Domains → add the DNS records),
#    set the sender. Until then the resend.dev test sender is used, which only
#    delivers to the Resend account owner's inbox.
# NEWSLETTER_FROM=How Is My Hair <hello@yourdomain.com>
# 3. Optional: Resend → Audiences → create one and paste its id so signups
#    show up in the dashboard list for Broadcasts (newsletters without code).
# RESEND_AUDIENCE_ID=

# --- Premium checkout (spec §13.1) — Stripe -----------------------------------
# stripe.com → Developers → API keys. Use sk_test_… first, sk_live_… to launch.
# Until set, the Unlock button shows a friendly "almost live" note.
STRIPE_SECRET_KEY=
# Optional: manage the price from the Stripe dashboard instead of lib/config.js.
# STRIPE_PRICE_ID=
# Optional: canonical site URL for checkout redirects (falls back to the
# request origin, which is correct on Vercel).
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
