// TutorApp database schema.
// See /BUILD_PLAN.md for how this maps to the product spec.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  NONBINARY
  UNSPECIFIED
}

enum Subject {
  MATH
  PHYSICS
  CHEMISTRY
  BIOLOGY
  COMPUTER_SCIENCE
  PSYCHOLOGY
  PHILOSOPHY
  NURSING
  OTHER
}

enum TutorStatus {
  APPLIED
  TRIAL
  ACTIVE
  SUSPENDED
  REMOVED
}

enum QuestionStatus {
  OPEN
  ANSWERED
  RESOLVED
}

enum ChatSessionStatus {
  WAITING
  ACTIVE
  ENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentType {
  SUBSCRIPTION
  PAY_PER_SESSION
  B2B_LICENSE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Shared profile fields
  timezone      String   @default("UTC")
  gender        Gender   @default(UNSPECIFIED)
  photoUrl      String?

  // Tutor-only fields
  tutorStatus       TutorStatus?
  tutorBio          String?
  tutorSubjects     Subject[]    @default([])
  tutorVerified     Boolean      @default(false)
  tutorAvailable    Boolean      @default(false)
  ratingAverage     Float        @default(0)
  ratingCount       Int          @default(0)
  stripeConnectId   String?
  stripeConnectReady Boolean     @default(false)

  // Student-only fields
  stripeCustomerId  String?

  // Relations
  questionsAsked    Question[]        @relation("QuestionAuthor")
  answers           Answer[]          @relation("AnswerAuthor")
  chatSessionsAsStudent ChatSession[] @relation("ChatStudent")
  chatSessionsAsTutor   ChatSession[] @relation("ChatTutor")
  messages          Message[]         @relation("MessageSender")
  subscription      Subscription?
  payments          Payment[]         @relation("PaymentUser")
  tipsGiven         Tip[]             @relation("TipFrom")
  tipsReceived      Tip[]             @relation("TipTo")
  payouts           Payout[]          @relation("PayoutTutor")
  ratingsGiven      Rating[]          @relation("RatingFrom")
  ratingsReceived   Rating[]          @relation("RatingTo")

  @@index([role])
  @@index([tutorStatus])
}

model Question {
  id          String         @id @default(cuid())
  authorId    String
  author      User           @relation("QuestionAuthor", fields: [authorId], references: [id])
  subject     Subject
  title       String
  body        String
  photoUrls   String[]       @default([])
  status      QuestionStatus @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  answers     Answer[]

  @@index([subject, status])
  @@index([authorId])
}

model Answer {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("AnswerAuthor", fields: [authorId], references: [id])
  body         String
  videoUrl     String?
  isVerifiedTutorAnswer Boolean @default(false)
  markedHelpful Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([questionId])
  @@index([authorId])
}

model ChatSession {
  id          String            @id @default(cuid())
  studentId   String
  student     User              @relation("ChatStudent", fields: [studentId], references: [id])
  tutorId     String?
  tutor       User?             @relation("ChatTutor", fields: [tutorId], references: [id])
  subject     Subject
  status      ChatSessionStatus @default(WAITING)
  requestedAt DateTime          @default(now())
  matchedAt   DateTime?
  endedAt     DateTime?
  // How this session was paid for, set when it starts
  paymentId   String?           @unique
  payment     Payment?          @relation(fields: [paymentId], references: [id])

  messages    Message[]
  tip         Tip?
  rating      Rating?

  @@index([status, subject])
  @@index([tutorId])
  @@index([studentId])
}

model Message {
  id            String      @id @default(cuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("MessageSender", fields: [senderId], references: [id])
  body          String
  photoUrl      String?
  createdAt     DateTime    @default(now())

  @@index([chatSessionId, createdAt])
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id])
  stripeSubscriptionId String?             @unique
  status               SubscriptionStatus  @default(INCOMPLETE)
  priceCents           Int                 @default(700)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  canceledAt           DateTime?
  cancelReason         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation("PaymentUser", fields: [userId], references: [id])
  type                  PaymentType
  status                PaymentStatus @default(PENDING)
  amountCents           Int
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())

  chatSession           ChatSession?

  @@index([userId, type])
}

model Tip {
  id            String      @id @default(cuid())
  chatSessionId String      @unique
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  fromId        String
  from          User        @relation("TipFrom", fields: [fromId], references: [id])
  toId          String
  to            User        @relation("TipTo", fields: [toId], references: [id])
  amountCents   Int
  platformCutCents Int      @default(0)
  stripePaymentIntentId String? @unique
  createdAt     DateTime    @default(now())

  @@index([toId])
}

model Rating {
  id            String      @id @default(cuid())
  chatSessionId String      @unique
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  fromId        String
  from          User        @relation("RatingFrom", fields: [fromId], references: [id])
  toId          String
  to            User        @relation("RatingTo", fields: [toId], references: [id])
  stars         Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([toId])
}

model Payout {
  id          String       @id @default(cuid())
  tutorId     String
  tutor       User         @relation("PayoutTutor", fields: [tutorId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  status      PayoutStatus @default(PENDING)
  stripeTransferId String?
  createdAt   DateTime     @default(now())
  paidAt      DateTime?

  @@index([tutorId, status])
}

// Phase 2 scaffold: bulk licenses for schools / tutoring centers / scholarship programs.
model B2BLicense {
  id            String   @id @default(cuid())
  organizationName String
  contactEmail  String
  seatCount     Int
  priceCents    Int
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

// Free-text intake for subjects not yet officially supported.
model SubjectRequest {
  id        String   @id @default(cuid())
  requesterEmail String
  subjectName    String
  notes          String?
  createdAt      DateTime @default(now())
}
