DATABASE_URL="postgresql://user:password@localhost:5432/tutorapp?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Email (Resend — leave blank to log verification emails to the console instead)
RESEND_API_KEY=""
EMAIL_FROM="TutorApp <onboarding@resend.dev>"

# Stripe (test mode keys go here — see BUILD_PLAN.md)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SUBSCRIPTION_PRICE_ID=""
STRIPE_PAY_PER_SESSION_PRICE_ID=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Anthropic (Claude API) — PARKED: the AI synthesis feature is fully disabled
# in the active flow (src/lib/ai.ts is not called anywhere). Nothing needs
# this key until the feature is deliberately re-enabled; see BUILD_PLAN.md.
ANTHROPIC_API_KEY=""

# Where dispute alerts go (a tutor disagreed with another tutor's verified
# answer). Informational only — leave blank to log to the console instead.
ADMIN_ALERT_EMAIL=""

# Bearer token required to trigger GET /api/cron/weekly-payouts
CRON_SECRET="replace-with-a-random-secret"

# Used by `npm run db:seed` to create the first admin account
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
