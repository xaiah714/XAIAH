# Postgres connection string
DATABASE_URL="postgresql://scholarship:scholarship@localhost:5432/scholarship_match?schema=public"

# Auth.js (NextAuth) — required for sign-in.
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth — primary sign-in path (console.cloud.google.com credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Twilio (SMS notifications) - Phase: notification pipeline
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend / email provider - Phase: notification pipeline
RESEND_API_KEY=""
EMAIL_FROM="notifications@scholarshipmatch.app"

# File uploads (status confirmation screenshots)
BLOB_READ_WRITE_TOKEN=""

# Shared secret required in the Authorization: Bearer header of requests to
# POST /api/cron/notifications (the deadline/renewal reminder sweep).
CRON_SECRET=""
